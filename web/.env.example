# Copy to .env.local for local use, and set the same variables in Vercel (Settings → Environment Variables).
# Never commit the real values.

# MongoDB connection string for the catalogues on /kataloger/<slug>. Without it those pages show the 404 page.
MONGODB_URI=
# Database name. Defaults to "selfi".
MONGODB_DB=selfi

# Contact form webhook (Slack, Zapier or Make).
CONTACT_WEBHOOK_URL=
