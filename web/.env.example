# Copy to .env.local for local use, and set the same variables in Vercel (Settings → Environment Variables).
# Never commit the real values.

# Contact form webhook (Slack, Zapier or Make).
CONTACT_WEBHOOK_URL=

# Support chat (lib/support). OPENAI_API_KEY is read on the server only: never put it in NEXT_PUBLIC_* or in code.
OPENAI_API_KEY=
SUPPORT_MODEL=gpt-6.1-sol
SUPPORT_RETENTION_DAYS=90
# Escalations: an SMS through Twilio (same account as the platform) to this number, with a link to admin.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=Selfi
SUPPORT_SMS_TO=
ADMIN_URL=https://admin.selfi.dk
